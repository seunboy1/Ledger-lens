DATABASE_URL=postgresql+asyncpg://ledgerlens:ledgerlens@localhost:5432/ledgerlens

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ledgerlens
MINIO_SECRET_KEY=ledgerlens-secret
MINIO_BUCKET=statements
MINIO_SECURE=false

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
INGEST_QUEUE=ledgerlens.ingest
CHUNK_QUEUE=ledgerlens.chunks

# Open-weight model via a managed inference provider (Groq/Together/HF),
# or point this at a self-hosted vLLM/Ollama endpoint instead.
LLM_PROVIDER_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Ask agent (LangGraph): auto = on when LLM_PROVIDER_API_KEY is set.
AGENT_MODE=auto

# Workspace the MCP server reads (default: the local demo workspace).
MCP_TENANT_ID=6f1c2a52-8d0e-4c1b-9a51-3e7d2c9b0a11

PAGES_PER_CHUNK=40

JWT_SECRET=change-me-in-production
